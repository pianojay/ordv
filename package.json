{
  "name": "ordv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "packet": "tsx src/cli.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.runtime.json && vite build",
    "test": "vitest run",
    "test:acceptance": "tsx tests/acceptance.ts",
    "test:remote": "tsx tests/remote.ts",
    "test:ui": "tsx tests/ui.ts",
    "ordv": "tsx src/cli.ts",
    "test:style": "tsx tests/style-acceptance.ts",
    "test:marginals": "tsx tests/marginals-acceptance.ts",
    "prepack": "npm run build",
    "test:runtime": "tsx tests/runtime-acceptance.ts",
    "test:reading": "tsx tests/reading-acceptance.ts",
    "test:layout": "tsx tests/table-acceptance.ts && tsx tests/figure-acceptance.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xyflow/react": "^12.0.0",
    "commander": "^14.0.0",
    "express": "^5.0.0",
    "highlight.js": "^11.0.0",
    "htmlparser2": "^12.0.0",
    "katex": "^0.16.0",
    "markdown-it": "^14.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "ordv": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/discover.js",
    "./model": "./dist/core/model.js",
    "./render": "./dist/core/render.js",
    "./export": "./dist/core/export.js",
    "./diagnostics": "./dist/core/diagnostics.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist/",
    "assets/",
    "THIRD_PARTY_NOTICES.md",
    "docs/collection-scope.md",
    "docs/runtime.md",
    "docs/reading.md",
    "docs/marginals.md",
    "docs/style-licensing.md"
  ]
}
